{
  "name": "daymo",
  "version": "1.0.0",
  "description": "A simple local-first calendar app for iOS and Android.",
  "private": true,
  "license": "MIT",
  "author": "Simon Bengtsson",
  "homepage": "https://github.com/simonbengtsson/daymo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbengtsson/daymo.git"
  },
  "bugs": {
    "url": "https://github.com/simonbengtsson/daymo/issues"
  },
  "keywords": [
    "android",
    "calendar",
    "expo",
    "ios",
    "react-native"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~57.0.8",
    "@legendapp/list": "^3.3.3",
    "@posthog/react-native-plugin": "^2.2.3",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "expo": "~57.0.9",
    "expo-application": "~57.0.2",
    "expo-blur": "~57.0.2",
    "expo-calendar": "~57.0.1",
    "expo-constants": "~57.0.8",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-localization": "~57.0.1",
    "expo-router": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "posthog-react-native": "^4.61.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.116.0"
  },
  "scripts": {
    "dev": "bun site/index.html",
    "deploy:site": "bunx wrangler deploy",
    "build:aab": "rm -f daymo.aab && bun run _build:unsigned:aab && bun run _prepare:unsigned:aab && bun run _sign:aab && rm -f unsigned.aab",
    "_build:unsigned:aab": "cd android && ./gradlew bundleRelease",
    "_prepare:unsigned:aab": "cp ./android/app/build/outputs/bundle/release/app-release.aab ./unsigned.aab && zip -d ./unsigned.aab 'META-INF/*.SF' 'META-INF/*.RSA' 'META-INF/*.DSA' 'META-INF/*.EC'",
    "_sign:aab": "jarsigner -verbose -sigalg SHA256withRSA -digestalg SHA-256 -keystore ./daymo_keystore.jks -storepass \"google.se2\" -signedjar ./daymo.aab ./unsigned.aab key0",
    "verify": "EXPO_NO_TELEMETRY=1 npx expo export:embed --platform ios --dev false --eager --skip-server --reset-cache",
    "check": "tsc --noEmit",
    "start": "expo start",
    "dip": "expo run:ios --configuration Release --device",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "deploy": "bun --version && wrangler deploy",
    "preview": "bun --version && wrangler dev"
  }
}
