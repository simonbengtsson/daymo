{
  "name": "daymo",
  "version": "1.0.0",
  "description": "A simple local-first calendar app for iOS and Android.",
  "private": true,
  "license": "MIT",
  "author": "Simon Bengtsson",
  "homepage": "https://github.com/simonbengtsson/daymo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simonbengtsson/daymo.git"
  },
  "bugs": {
    "url": "https://github.com/simonbengtsson/daymo/issues"
  },
  "keywords": [
    "android",
    "calendar",
    "expo",
    "ios",
    "react-native"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/material-symbols": "^0.1.1",
    "@expo/ui": "~58.0.2",
    "@legendapp/list": "^3.3.11",
    "@posthog/react-native-plugin": "^2.9.0",
    "@react-native-vector-icons/ionicons": "^13.1.4",
    "expo": "^58.0.0-preview.2",
    "expo-application": "~58.0.1",
    "expo-blur": "~58.0.0",
    "expo-calendar": "~58.0.1",
    "expo-constants": "~58.0.2",
    "expo-dev-client": "~58.0.2",
    "expo-device": "~58.0.0",
    "expo-file-system": "~58.0.0",
    "expo-font": "~58.0.1",
    "expo-glass-effect": "~58.0.0",
    "expo-image": "~58.0.2",
    "expo-linear-gradient": "~58.0.0",
    "expo-linking": "~58.0.2",
    "expo-localization": "~58.0.0",
    "expo-router": "~58.0.3",
    "expo-splash-screen": "~58.0.0",
    "expo-status-bar": "~58.0.0",
    "expo-symbols": "~58.0.1",
    "expo-system-ui": "~58.0.1",
    "expo-web-browser": "~58.0.0",
    "posthog-react-native": "^4.73.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.88.0-rc.0",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-reanimated": "4.6.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.12.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.1",
    "typescript": "~6.0.3",
    "wrangler": "^4.131.2"
  },
  "scripts": {
    "build:aab": "rm -f daymo.aab && bun run _build:unsigned:aab && bun run _prepare:unsigned:aab && bun run _sign:aab && rm -f unsigned.aab && echo 'Done: daymo.aab'",
    "_build:unsigned:aab": "cd android && ./gradlew bundleRelease",
    "_prepare:unsigned:aab": "cp ./android/app/build/outputs/bundle/release/app-release.aab ./unsigned.aab && zip -d ./unsigned.aab 'META-INF/*.SF' 'META-INF/*.RSA' 'META-INF/*.DSA' 'META-INF/*.EC'",
    "_sign:aab": "jarsigner -verbose -sigalg SHA256withRSA -digestalg SHA-256 -keystore ./daymo_keystore.jks -storepass \"google.se2\" -signedjar ./daymo.aab ./unsigned.aab key0",
    "verify": "EXPO_NO_TELEMETRY=1 npx expo export:embed --platform ios --dev false --eager --skip-server --reset-cache",
    "check": "tsc --noEmit",
    "start": "expo start",
    "ri": "expo run:ios --device",
    "dip": "expo run:ios --configuration Release --device",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "expo lint",
    "dev:site": "bun site/index.html",
    "deploy:site": "wrangler deploy"
  }
}
